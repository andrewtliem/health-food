# ==============================================================================
# Eden Healthy Market - Environment Variables Template
# ==============================================================================
# IMPORTANT: DO NOT PUT REAL SECRETS IN THIS FILE!
# In Cloudflare Pages, production secrets should be added via:
#   npx wrangler pages secret put GEMINI_API_KEY --project-name=eden-healthy-market
# Or in Cloudflare Dashboard: Settings -> Environment variables -> Production
# ==============================================================================

# (Optional) Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# If omitted, the chatbot automatically uses Cloudflare Workers AI (Llama 3.2) for free!
GEMINI_API_KEY=your_gemini_api_key_here

# Midtrans Payment Gateway (Sandbox / Production)
# Configure via: npx wrangler pages secret put MIDTRANS_SERVER_KEY --project-name=eden-healthy-market
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
